# Backend environment variables (Django)
# Copy this file to .env and fill in real values. NEVER commit .env.
# Production checklist: docs/SECURITY_CHECKLIST.md

# --- Django ---
# Generate a key: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
# Development only. Must be False in production.
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- PostgreSQL ---
DB_NAME=ecommerce_db
DB_USER=postgres
DB_PASSWORD=your-db-password
DB_HOST=localhost
DB_PORT=5432

# --- CORS / CSRF: exact frontend origin(s), comma-separated. Never use "*". ---
CORS_ALLOWED_ORIGINS=http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:5173

# --- JWT ---
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=30
JWT_REFRESH_TOKEN_LIFETIME_DAYS=1

# --- Frontend URL (payment redirects) ---
FRONTEND_URL=http://localhost:5173

# --- Stripe (test mode). Leave the placeholders to use the built-in demo gateway. ---
STRIPE_SECRET_KEY=sk_test_your_key_here
STRIPE_WEBHOOK_SECRET=whsec_your_secret_here

# --- bKash Tokenized Checkout (leave empty to use the demo gateway in development) ---
# Sandbox base URL is the default; for live use https://tokenized.pay.bka.sh/v1.2.0-beta
BKASH_BASE_URL=https://tokenized.sandbox.bka.sh/v1.2.0-beta
BKASH_APP_KEY=
BKASH_APP_SECRET=
BKASH_USERNAME=
BKASH_PASSWORD=

# --- Nagad Merchant API (leave empty to use the demo gateway in development) ---
NAGAD_BASE_URL=http://sandbox.mynagad.com:10080/remote-payment-gateway-1.0
NAGAD_MERCHANT_ID=
NAGAD_MERCHANT_NUMBER=
# RSA keys as one-line base64 (or full PEM). Never commit real keys.
NAGAD_MERCHANT_PRIVATE_KEY=
NAGAD_PG_PUBLIC_KEY=

# --- Demo payment pages (simulated Card / bKash / Nagad). Default: on when DEBUG=True. ---
# Must stay off in production.
# PAYMENTS_ALLOW_DEMO=True

# --- AI shopping assistant (Claude). Get a key at https://platform.claude.com ---
# Leave empty to hide the AI answers (the chat shows "not set up yet").
ANTHROPIC_API_KEY=
# ASSISTANT_MODEL=claude-opus-5-5

# --- Rate limits (optional) ---
# THROTTLE_CHAT=20/minute
# THROTTLE_AUTH=10/minute
# THROTTLE_ANON=300/hour
# THROTTLE_USER=3000/hour

# --- Production HTTPS (used only when DJANGO_DEBUG=False) ---
# SECURE_SSL_REDIRECT=True
# SECURE_HSTS_SECONDS=31536000
# SECURE_HSTS_PRELOAD=False
# LOG_LEVEL=INFO
